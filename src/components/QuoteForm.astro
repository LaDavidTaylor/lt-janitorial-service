---
import { business } from "../data/business";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<form class:list={["quote-form", { compact }]} data-quote-form>
  <label class="website-field" aria-hidden="true">
    <span>Website</span>
    <input name="website" type="text" autocomplete="off" tabindex="-1" />
  </label>
  <div class="form-grid">
    <label>
      <span>Your name</span>
      <input name="name" type="text" autocomplete="name" required />
    </label>
    <label>
      <span>Company or facility</span>
      <input name="company" type="text" autocomplete="organization" required />
    </label>
    <label>
      <span>Phone</span>
      <input name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
    </label>
    <label>
      <span>Email</span>
      <input name="email" type="email" autocomplete="email" required />
    </label>
    <label>
      <span>Facility type</span>
      <select name="facility" required>
        <option value="">Select one</option>
        <option>Office or corporate facility</option>
        <option>Warehouse or distribution center</option>
        <option>Medical office or clinic</option>
        <option>Restaurant or hospitality space</option>
        <option>Retail store or showroom</option>
        <option>School or activity center</option>
        <option>Manufacturing or industrial facility</option>
        <option>Construction or renovated space</option>
        <option>Other commercial facility</option>
      </select>
    </label>
    <label>
      <span>City or ZIP code</span>
      <input name="location" type="text" autocomplete="postal-code" required />
    </label>
    <label>
      <span>Approximate square footage</span>
      <input name="size" type="text" inputmode="numeric" placeholder="Example: 12,000" />
    </label>
    <label>
      <span>Preferred frequency</span>
      <select name="frequency">
        <option>Needs discussion</option>
        <option>One time project</option>
        <option>Daily</option>
        <option>Several times each week</option>
        <option>Weekly</option>
        <option>Monthly or periodic</option>
      </select>
    </label>
    <label>
      <span>Program interest</span>
      <select name="program">
        <option value="Not sure yet">Not sure yet</option>
        <option value="Silver">Silver, preventive maintenance</option>
        <option value="Gold">Gold, daily excellence</option>
        <option value="Platinum">Platinum, total care</option>
      </select>
    </label>
    <label>
      <span>Preferred service window</span>
      <input name="serviceWindow" type="text" placeholder="Example: weekdays after 6 PM" />
    </label>
    <label>
      <span>Desired start date</span>
      <input name="startDate" type="date" />
    </label>
    <label class="full">
      <span>Services or priorities</span>
      <textarea name="services" rows="4" placeholder="Tell us which rooms, floors, or project areas need attention."></textarea>
    </label>
    <label class="full">
      <span>Additional notes</span>
      <textarea name="notes" rows="3" placeholder="Share access details, operating constraints, or anything else the team should know."></textarea>
    </label>
  </div>

  <label class="consent">
    <input name="consent" type="checkbox" required />
    <span>I agree to send these details to LT Janitorial for a response to my request. See the <a href="/privacy">privacy notice</a>.</span>
  </label>

  <button class="button button-gold" type="submit">Send my quote request</button>
  <p class="form-status" data-form-status aria-live="polite"></p>
  <noscript>
    <p>JavaScript is required to prepare the email. You can email <a href={business.emailHref}>{business.email}</a> or call <a href={business.phoneHref}>{business.phoneDisplay}</a>.</p>
  </noscript>
</form>

<script is:inline define:vars={{ destination: business.email }}>
  document.querySelectorAll("[data-quote-form]").forEach((formElement) => {
    if (!(formElement instanceof HTMLFormElement)) return;

    const requestedProgram = new URLSearchParams(window.location.search).get("program")?.toLowerCase();
    const programSelect = formElement.elements.namedItem("program");
    if (programSelect instanceof HTMLSelectElement && requestedProgram) {
      const programNames = { silver: "Silver", gold: "Gold", platinum: "Platinum" };
      const selectedProgram = programNames[requestedProgram];
      if (selectedProgram) programSelect.value = selectedProgram;
    }

    formElement.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!formElement.reportValidity()) return;

      const data = new FormData(formElement);
      const status = formElement.querySelector("[data-form-status]");
      const submitButton = formElement.querySelector('button[type="submit"]');
      if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;
      if (status) status.textContent = "Sending your request securely...";

      try {
        const response = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(Object.fromEntries(data.entries())),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.ok) throw new Error(result.error || "Unable to send");

        formElement.reset();
        if (status) status.textContent = "Thank you. Your request was sent to LT Janitorial, and the team can now follow up with you.";
      } catch {
        if (status) {
          status.textContent = "The form could not send your request. Please email ";
          const fallbackLink = document.createElement("a");
          fallbackLink.href = `mailto:${destination}`;
          fallbackLink.textContent = destination;
          status.append(fallbackLink, " or call LT Janitorial.");
        }
      } finally {
        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
      }
    });
  });
</script>

<style>
  .quote-form {
    position: relative;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--line-dark);
    background: var(--ink-soft);
  }

  .website-field {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  label {
    display: grid;
    gap: 0.5rem;
  }

  label > span:first-child {
    color: var(--gold-light);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .full {
    grid-column: 1 / -1;
  }

  input,
  select,
  textarea {
    width: 100%;
    border: 1px solid rgba(239, 226, 145, 0.26);
    border-radius: 0;
    background: #0e0d0a;
    color: var(--ivory);
  }

  input,
  select {
    min-height: 3.4rem;
    padding: 0.75rem 0.9rem;
  }

  textarea {
    min-height: 8rem;
    padding: 0.9rem;
    resize: vertical;
  }

  input::placeholder,
  textarea::placeholder {
    color: #968e83;
  }

  .consent {
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: start;
    margin: 1.25rem 0;
    color: var(--muted-dark);
    font-size: 0.82rem;
  }

  .consent input {
    width: 1rem;
    min-height: 1rem;
    margin-top: 0.25rem;
  }

  .consent span:first-of-type {
    color: var(--muted-dark);
    font-size: inherit;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
  }

  .consent a {
    color: var(--gold-light);
  }

  button:disabled {
    cursor: wait;
    opacity: 0.65;
  }

  .form-status {
    min-height: 1.5rem;
    margin: 1rem 0 0;
    color: var(--gold-light);
    font-size: 0.85rem;
  }

  @media (max-width: 680px) {
    .form-grid {
      grid-template-columns: 1fr;
    }

    .full {
      grid-column: auto;
    }
  }
</style>
