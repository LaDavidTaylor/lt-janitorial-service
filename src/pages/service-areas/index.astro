---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InnerHero from "../../components/InnerHero.astro";
import CTASection from "../../components/CTASection.astro";
import { locations } from "../../data/locations";

const counties = locations.filter((location) => location.type === "county");
const cities = locations.filter((location) => location.type === "city" && location.launchStatus === "ready");
---

<BaseLayout
  title="Commercial Cleaning Service Areas"
  description="Explore LT Janitorial commercial cleaning coverage across Dallas County, Collin County, Rockwall County, and listed cities in Dallas and East DFW."
  canonicalPath="/service-areas"
>
  <InnerHero
    eyebrow="Dallas and East DFW"
    title="Local pages built from local facility needs."
    intro="LT Janitorial’s core territory includes Dallas, Collin, and Rockwall counties. Each location page focuses on the commercial environments and cleaning priorities that distinguish that market."
    image="/images/generated/commercial-cleaning-hero.webp"
    imageAlt="North Texas commercial corridor at evening"
    secondaryHref="/services"
    secondaryLabel="Explore services"
  />

  <section class="section section-light">
    <div class="shell">
      <div class="section-intro">
        <div><p class="eyebrow">Core county coverage</p><h2>Three counties form the core service territory.</h2></div>
        <p>Service availability is confirmed from the facility address, operating window, requested work, and current route capacity.</p>
      </div>
      <div class="card-grid county-grid">
        {counties.map((location, index) => (
          <article class="editorial-card">
            <span class="card-index">0{index + 1} / County profile</span>
            <h3>{location.name}</h3>
            <p>{location.hero.lede}</p>
            <a class="text-link" href={`/service-areas/${location.slug}`}>Explore county coverage <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-paper">
    <div class="shell">
      <div class="section-intro">
        <div><p class="eyebrow">City coverage</p><h2>Local facility priorities shape every city profile.</h2></div>
        <p>Explore how offices, warehouses, restaurants, medical spaces, retail environments, and commercial growth create different cleaning priorities across the current service route.</p>
      </div>
      <div class="city-grid">
        {cities.map((location, index) => (
          <a class="city-card" href={`/service-areas/${location.slug}`}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{location.name}</h3>
            <p>{location.hero.lede}</p>
            <small>{location.county}</small>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection title="Confirm whether your facility is inside the service route." />
</BaseLayout>

<style>
  .city-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line-light);
  }

  .city-card {
    min-height: 19rem;
    display: grid;
    align-content: start;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-right: 1px solid var(--line-light);
    border-bottom: 1px solid var(--line-light);
    color: var(--ink);
    text-decoration: none;
  }

  .city-card > span {
    margin-bottom: 3.5rem;
    color: var(--gold-deep);
    font-size: 0.68rem;
    font-weight: 800;
  }

  .city-card p {
    color: var(--muted-light);
  }

  .city-card small {
    margin-top: auto;
    color: var(--gold-deep);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 720px) {
    .city-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
