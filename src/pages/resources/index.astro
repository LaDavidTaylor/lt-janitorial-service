---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InnerHero from "../../components/InnerHero.astro";
import CTASection from "../../components/CTASection.astro";
import { guides } from "../../data/guides";
import { getImageAlt } from "../../data/images";
---

<BaseLayout
  title="Commercial Cleaning Resources"
  description="Practical guides for commercial cleaning quotes, janitorial selection, office frequency, floor care, post construction cleanup, and warehouse planning."
  canonicalPath="/resources"
>
  <InnerHero
    eyebrow="Facility planning resources"
    title="Useful answers before the proposal reaches the inbox."
    intro="These guides explain the questions behind commercial cleaning scope, frequency, floor care, closeout work, and warehouse planning so facility teams can prepare for a useful conversation."
    image="/images/generated/office-cleaning-hero.webp"
    imageAlt="Commercial office with a refined evening cleaning environment"
    secondaryHref="/faq"
    secondaryLabel="Browse quick answers"
  />

  <section class="section section-light">
    <div class="shell resource-grid">
      {guides.map((guide, index) => (
        <article class="resource-card">
          <div class="resource-image"><img src={guide.image} alt={getImageAlt(guide.image)} width="900" height="620" loading="lazy" /></div>
          <div class="resource-copy">
            <span>{String(index + 1).padStart(2, "0")} / {guide.category}</span>
            <h2>{guide.title}</h2>
            <p>{guide.answer}</p>
            <a class="text-link" href={`/resources/${guide.slug}`}>Read the guide <b aria-hidden="true">↗</b></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <CTASection title="Turn the research into a facility conversation." />
</BaseLayout>

<style>
  .resource-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .resource-card {
    border: 1px solid var(--line-light);
    background: var(--paper);
  }

  .resource-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .resource-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .resource-copy {
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .resource-copy > span {
    display: block;
    margin-bottom: 3rem;
    color: var(--gold-deep);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .resource-copy h2 {
    font-size: clamp(2rem, 4vw, 3.5rem);
  }

  .resource-copy p {
    color: var(--muted-light);
  }

  @media (max-width: 760px) {
    .resource-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
