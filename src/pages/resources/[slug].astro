---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FAQList from "../../components/FAQList.astro";
import CTASection from "../../components/CTASection.astro";
import { guides, type GuidePage } from "../../data/guides";
import { getImageAlt } from "../../data/images";
import { breadcrumbSchema, faqSchema } from "../../lib/schema";

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

interface Props {
  guide: GuidePage;
}

const { guide } = Astro.props;
const schemas = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Resources", path: "/resources" },
    { name: guide.title, path: `/resources/${guide.slug}` },
  ]),
  faqSchema(guide.faqs),
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: guide.title,
    description: guide.metaDescription,
    image: new URL(guide.image, "https://ltjanitorial.vercel.app").href,
    datePublished: "2026-08-31",
    dateModified: "2026-08-31",
    author: { "@type": "Organization", "@id": "https://ltjanitorial.vercel.app/#organization", name: "LT Janitorial Service, LLC" },
    publisher: { "@type": "Organization", "@id": "https://ltjanitorial.vercel.app/#organization", name: "LT Janitorial Service, LLC" },
    mainEntityOfPage: new URL(`/resources/${guide.slug}`, "https://ltjanitorial.vercel.app").href,
  },
];
---

<BaseLayout
  title={guide.seoTitle}
  description={guide.metaDescription}
  canonicalPath={`/resources/${guide.slug}`}
  image={guide.image}
  imageAlt={getImageAlt(guide.image)}
  schemas={schemas}
>
  <Breadcrumbs items={[{ label: "Resources", href: "/resources" }, { label: guide.title }]} />
  <section class="guide-hero">
    <div class="guide-media"><img src={guide.image} alt={getImageAlt(guide.image)} width="1672" height="941" loading="eager" fetchpriority="high" /></div>
    <div class="shell guide-content">
      <p class="eyebrow">{guide.category} guide</p>
      <h1>{guide.heroTitle}</h1>
      <p class="lede">{guide.heroIntro}</p>
    </div>
  </section>

  <section class="answer-bar section-light">
    <div class="shell"><strong>Direct answer</strong><p>{guide.answer}</p></div>
  </section>

  <article class="section section-paper">
    <div class="shell guide-layout">
      <div class="guide-article">
        {guide.sections.map((section, index) => (
          <section>
            <p class="eyebrow">Section {String(index + 1).padStart(2, "0")}</p>
            <h2>{section.title}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.checklist && (
              <div class="checklist"><h3>Planning checklist</h3><ul>{section.checklist.map((item) => <li>{item}</li>)}</ul></div>
            )}
          </section>
        ))}
      </div>
      <aside class="guide-aside">
        <p class="eyebrow">Related services</p>
        {guide.relatedServices.map((item) => <a href={item.href}>{item.label}<span aria-hidden="true">↗</span></a>)}
      </aside>
    </div>
  </article>

  <section class="section section-light">
    <div class="shell guide-faq"><div><p class="eyebrow">Related questions</p><h2>Keep planning.</h2></div><FAQList items={guide.faqs} /></div>
  </section>

  <CTASection title="Take the next question into the building." />
</BaseLayout>

<style>
  .guide-hero {
    position: relative;
    min-height: 46rem;
    display: grid;
    align-items: end;
    isolation: isolate;
    overflow: hidden;
  }

  .guide-media {
    position: absolute;
    z-index: -2;
    inset: 0;
  }

  .guide-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .guide-hero::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(90deg, rgba(9, 9, 7, 0.97), rgba(9, 9, 7, 0.66) 65%, rgba(9, 9, 7, 0.2));
    content: "";
  }

  .guide-content {
    max-width: 66rem;
    padding-block: clamp(5rem, 10vw, 9rem);
  }

  .guide-content h1 {
    font-size: clamp(3.3rem, 7vw, 7rem);
  }

  .answer-bar {
    padding-block: 2rem;
    border-bottom: 1px solid var(--line-light);
  }

  .answer-bar .shell {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 2rem;
  }

  .answer-bar strong {
    color: var(--gold-deep);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .answer-bar p {
    max-width: 58rem;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    line-height: 1.4;
  }

  .guide-layout,
  .guide-faq {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(16rem, 0.3fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
  }

  .guide-article > section + section {
    margin-top: 5rem;
    padding-top: 5rem;
    border-top: 1px solid var(--line-light);
  }

  .guide-article > section > p:not(.eyebrow) {
    color: var(--muted-light);
    font-size: 1.07rem;
  }

  .checklist {
    margin-top: 2.5rem;
    padding: 2rem;
    background: var(--ivory-deep);
  }

  .checklist h3 {
    font-size: 1.5rem;
  }

  .checklist ul {
    columns: 2;
    padding-left: 1.1rem;
  }

  .guide-aside {
    position: sticky;
    top: 7.5rem;
    display: grid;
    border-top: 2px solid var(--gold-deep);
  }

  .guide-aside .eyebrow {
    padding-top: 1.25rem;
  }

  .guide-aside a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line-light);
    color: var(--ink);
    text-decoration: none;
  }

  @media (max-width: 800px) {
    .guide-layout,
    .guide-faq,
    .answer-bar .shell {
      grid-template-columns: 1fr;
    }

    .guide-aside {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .checklist ul {
      columns: 1;
    }
  }
</style>
