---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FAQList from "../../components/FAQList.astro";
import CTASection from "../../components/CTASection.astro";
import { business } from "../../data/business";
import { getImageAlt } from "../../data/images";
import { services, type ServicePage } from "../../data/services";
import { breadcrumbSchema, faqSchema, serviceSchema } from "../../lib/schema";

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props {
  service: ServicePage;
}

const { service } = Astro.props;
const secondaryLabel = service.hero.secondaryCta.toLowerCase();
const secondaryHref = secondaryLabel.includes("call") || secondaryLabel.includes("discuss")
  ? business.phoneHref
  : secondaryLabel.includes("explore") || secondaryLabel.includes("review") || secondaryLabel.includes("see") || secondaryLabel.includes("compare")
    ? "/services"
    : "/quote";
const guideByCategory: Record<string, { label: string; href: string }> = {
  "Commercial Cleaning": { label: "Commercial cleaning quote factors", href: "/resources/commercial-cleaning-cost-factors-dallas" },
  "Office Cleaning": { label: "Office cleaning frequency guide", href: "/resources/office-cleaning-frequency-guide" },
  "Floor Maintenance": { label: "Strip and wax versus burnishing", href: "/resources/strip-and-wax-versus-burnishing" },
  "Warehouse Cleaning": { label: "Warehouse cleaning planning guide", href: "/resources/warehouse-cleaning-plan" },
  "Medical Facility Cleaning": { label: "Medical facility cleaning requirements", href: "/resources/medical-facility-cleaning-requirements" },
  "Restaurant Cleaning": { label: "How to compare janitorial proposals", href: "/resources/choose-a-commercial-janitorial-service" },
  "Post Construction Cleaning": { label: "Post construction cleaning checklist", href: "/resources/post-construction-cleaning-checklist" },
};
const connectedLinks = [...service.relatedLinks, guideByCategory[service.category]];
const schemas = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Services", path: "/services" },
    { name: service.name, path: `/services/${service.slug}` },
  ]),
  serviceSchema(service.name, service.schemaDescription, undefined, `/services/${service.slug}`),
  faqSchema(service.faqs),
];
---

<BaseLayout
  title={service.seo.title}
  description={service.seo.description}
  canonicalPath={`/services/${service.slug}`}
  image={service.image.src}
  imageAlt={getImageAlt(service.image.src)}
  schemas={schemas}
>
  <Breadcrumbs items={[{ label: "Services", href: "/services" }, { label: service.name }]} />

  <section class="service-hero">
    <div class="service-media"><img src={service.image.src} alt={getImageAlt(service.image.src)} width="1672" height="941" loading="eager" fetchpriority="high" style={`object-position:${service.image.focalPoint}`} /></div>
    <div class="shell service-hero-content">
      <p class="eyebrow">{service.hero.eyebrow}</p>
      <h1>{service.hero.title}</h1>
      <p class="lede">{service.hero.lede}</p>
      <div class="hero-actions">
        <a class="button button-gold" href="/quote">{service.hero.primaryCta}</a>
        <a class="button button-ghost" href={secondaryHref}>{service.hero.secondaryCta}</a>
      </div>
    </div>
    <div class="shell service-identity">
      <span>{service.kind === "category" ? "Primary service" : "Focused service"}</span>
      <strong>{service.name}</strong>
      <small>{service.category}</small>
    </div>
  </section>

  <section class="direct-answer section-light">
    <div class="shell"><p class="eyebrow">What this service is for</p><p>{service.serviceContext}</p></div>
  </section>

  <section class="section section-paper">
    <div class="shell content-layout">
      <div class="prose service-prose">
        <h2>What {service.name} can include.</h2>
        <p>{service.overview[0]}</p>
        <p>{service.overview[1]}</p>
        <div class="detail-list">
          {service.inclusions.map((item, index) => (
            <article><span>0{index + 1}</span><h3>{item}</h3></article>
          ))}
        </div>
      </div>
      <aside class="detail-aside">
        <p class="eyebrow">Service profile</p>
        <h3>{service.name}</h3>
        <p>Available within the Dallas, Collin, and Rockwall County service territory. Final fit, access, frequency, and methods are confirmed after the facility is reviewed.</p>
        <a class="button button-dark" href="/quote">Request this service</a>
        <a class="aside-call" href={business.phoneHref}>Call {business.phoneDisplay}</a>
      </aside>
    </div>
  </section>

  <section class="section section-dark">
    <div class="shell">
      <div class="section-intro">
        <div><p class="eyebrow">How the scope develops</p><h2>A process built around the service.</h2></div>
        <p>Each service follows its own operating logic. These steps show what LT Janitorial needs to understand before the work is placed on the calendar.</p>
      </div>
      <div class="process-grid">
        {service.process.map((step, index) => (
          <article class="process-step"><span class="step-number">{String(index + 1).padStart(2, "0")}</span><h3>{step.title}</h3><p>{step.description}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-light">
    <div class="shell service-links-layout">
      <div><p class="eyebrow">Connected work</p><h2>Keep the surrounding facility in view.</h2><p>Related services help facility teams connect the immediate need with the rooms, floors, or project phases around it.</p></div>
      <div class="related-ledger">
        {connectedLinks.map((link, index) => <a href={link.href}><span>{String(index + 1).padStart(2, "0")}</span><strong>{link.label}</strong><b aria-hidden="true">↗</b></a>)}
      </div>
    </div>
  </section>

  <section class="section section-paper">
    <div class="shell faq-layout"><div><p class="eyebrow">{service.name} questions</p><h2>Answers for the planning conversation.</h2></div><FAQList items={service.faqs} /></div>
  </section>

  <CTASection
    eyebrow={service.name}
    title="Bring the service question into the building."
    copy="Share the facility, location, operating window, surfaces, and desired result. LT Janitorial can use those details to determine the next practical step."
  />
</BaseLayout>

<style>
  .service-hero {
    position: relative;
    min-height: min(76rem, calc(100svh - 8rem));
    display: grid;
    align-items: end;
    isolation: isolate;
    overflow: hidden;
  }

  .service-media {
    position: absolute;
    z-index: -2;
    inset: 0;
  }

  .service-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .service-hero::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(90deg, rgba(9, 9, 7, 0.98), rgba(9, 9, 7, 0.76) 58%, rgba(9, 9, 7, 0.2)), linear-gradient(0deg, rgba(9, 9, 7, 0.94), transparent 55%);
    content: "";
  }

  .service-hero-content {
    max-width: 72rem;
    padding-block: clamp(7rem, 12vw, 12rem) 3rem;
  }

  .service-hero h1 {
    max-width: 68rem;
    font-size: clamp(3.4rem, 7vw, 7rem);
  }

  .service-identity {
    display: grid;
    grid-template-columns: 10rem 1fr auto;
    gap: 1.5rem;
    align-items: center;
    padding-block: 1.2rem;
    border-top: 1px solid var(--line-dark);
    color: var(--muted-dark);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .service-identity strong {
    color: var(--ivory);
    font-size: 0.8rem;
  }

  .service-identity small {
    color: var(--gold-light);
  }

  .direct-answer {
    padding-block: 2rem;
  }

  .direct-answer .shell {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 2rem;
  }

  .direct-answer .eyebrow {
    margin: 0;
  }

  .direct-answer p:last-child {
    max-width: 60rem;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    line-height: 1.4;
  }

  .detail-list article {
    min-height: 13rem;
  }

  .detail-list article span {
    display: block;
    margin-bottom: 2rem;
    color: var(--gold-deep);
    font-size: 0.68rem;
    font-weight: 800;
  }

  .detail-list h3 {
    font-size: 1.45rem;
  }

  .aside-call {
    display: block;
    margin-top: 1rem;
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 800;
    text-align: center;
  }

  .service-links-layout,
  .faq-layout {
    display: grid;
    grid-template-columns: minmax(16rem, 0.4fr) minmax(0, 0.6fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .service-links-layout > div:first-child > p:last-child {
    color: var(--muted-light);
  }

  .related-ledger {
    border-top: 1px solid var(--line-light);
  }

  .related-ledger a {
    display: grid;
    grid-template-columns: 3rem 1fr 2rem;
    gap: 1rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--line-light);
    color: var(--ink);
    text-decoration: none;
  }

  .related-ledger span {
    color: var(--gold-deep);
    font-size: 0.68rem;
    font-weight: 800;
  }

  .related-ledger strong {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 500;
  }

  @media (max-width: 800px) {
    .service-identity,
    .direct-answer .shell,
    .service-links-layout,
    .faq-layout {
      grid-template-columns: 1fr;
    }

    .service-identity {
      gap: 0.2rem;
    }
  }
</style>
