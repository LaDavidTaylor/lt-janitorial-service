---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProofStrip from "../components/ProofStrip.astro";
import FAQList from "../components/FAQList.astro";
import CTASection from "../components/CTASection.astro";
import { business } from "../data/business";
import { services } from "../data/services";
import { industries } from "../data/industries";
import { locations } from "../data/locations";
import { faqSchema } from "../lib/schema";

const serviceSlugs = [
  "commercial-cleaning",
  "floor-maintenance",
  "office-cleaning",
  "warehouse-cleaning",
  "medical-facility-cleaning",
  "restaurant-cleaning",
  "post-construction-cleaning",
];
const featuredServices = serviceSlugs.map((slug) => services.find((item) => item.slug === slug)).filter(Boolean);
const featuredIndustries = industries.slice(0, 6);
const featuredCities = locations.filter((item) => item.type === "city" && item.launchStatus !== "owner_confirmation_required").slice(0, 8);
const homeFaqs = [
  {
    question: "Which parts of North Texas does LT Janitorial serve?",
    answer:
      "LT Janitorial currently identifies Dallas County, Collin County, and Rockwall County as its core service territory. City coverage includes Dallas, Garland, Mesquite, Rockwall, Royse City, Heath, Plano, McKinney, and Frisco.",
  },
  {
    question: "Does LT Janitorial provide recurring commercial cleaning?",
    answer:
      "Yes. The current service catalog includes routine office cleaning, daily deep cleaning, workspace sanitization, restroom care, waste removal, and facility specific recurring plans.",
  },
  {
    question: "Can floor care be added to a janitorial program?",
    answer:
      "Floor care can be planned with recurring cleaning or scoped as a separate project. Available services include strip and wax work, burnishing, annual restoration, preventive care, and industrial sweeping.",
  },
  {
    question: "How does a commercial cleaning quote begin?",
    answer:
      "Start with the facility type, location, approximate size, desired frequency, service window, and priority areas. A facility walk through can then clarify surfaces, traffic, access, and the required scope.",
  },
];
---

<BaseLayout
  title="Dallas Commercial Cleaning and Floor Care"
  description="Veteran owned commercial cleaning, floor care, post construction cleanup, and facility support across Dallas, Collin, and Rockwall counties."
  schemas={[faqSchema(homeFaqs)]}
>
  <section class="page-hero home-hero">
    <div class="hero-media">
      <img src="/images/generated/commercial-cleaning-hero.webp" alt="Commercial cleaning professionals work in a modern office lobby after business hours" width="1800" height="1200" loading="eager" fetchpriority="high" />
    </div>
    <div class="shell hero-content">
      <div class="hero-copy">
        <p class="eyebrow">Commercial cleaning across Dallas and East DFW</p>
        <h1>Clean that carries the <em>whole facility.</em></h1>
        <p class="lede">Recurring janitorial service, commercial floor care, and project cleaning built around how your facility moves, works, and represents your organization.</p>
        <div class="hero-actions">
          <a class="button button-gold" href="/quote">Request a facility quote</a>
          <a class="button button-ghost" href={business.phoneHref}>Call {business.phoneDisplay}</a>
        </div>
      </div>
      <div class="hero-note">
        <strong>Core service area</strong>
        Dallas County<br />Collin County<br />Rockwall County
      </div>
    </div>
  </section>

  <ProofStrip />

  <section class="section section-light">
    <div class="shell">
      <div class="section-intro">
        <div>
          <p class="eyebrow">The LT service system</p>
          <h2>One accountable standard. Built for different facilities.</h2>
        </div>
        <p>An office, warehouse, clinic, restaurant, and construction closeout do not ask for the same work. LT Janitorial starts with the operating environment, then develops the service scope around the surfaces, traffic, access, and priorities inside it.</p>
      </div>

      <div class="card-grid service-feature-grid">
        {featuredServices.map((service, index) => service && (
          <article class="editorial-card">
            <span class="card-index">{String(index + 1).padStart(2, "0")} / {service.category}</span>
            <h3>{service.name}</h3>
            <p>{service.hero.lede}</p>
            <a class="text-link" href={`/services/${service.slug}`}>Explore service <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>

      <p class="catalog-link"><a class="button button-dark" href="/services">View the complete service catalog</a></p>
    </div>
  </section>

  <section class="section section-dark precision-section">
    <div class="shell precision-layout">
      <div class="image-panel">
        <img src="/images/generated/floor-care-hero.webp" alt="A floor care technician operates a commercial burnisher in a modern corridor" width="1400" height="1100" loading="lazy" />
      </div>
      <div class="precision-copy">
        <p class="eyebrow">Floor care as a planned asset</p>
        <h2>Protect the finish before the floor starts asking for rescue.</h2>
        <p>Preventive maintenance, burnishing, strip and wax service, and annual restoration work best when each one has a clear purpose. LT Janitorial can separate daily floor tasks from planned restorative work so the maintenance calendar reflects the surface condition and facility traffic.</p>
        <div class="mini-links">
          <a href="/services/preventive-floor-care">Preventive floor care</a>
          <a href="/services/floor-burnishing">Floor burnishing</a>
          <a href="/services/strip-and-wax">Strip and wax</a>
          <a href="/services/annual-floor-restoration">Annual restoration</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-paper">
    <div class="shell">
      <div class="section-intro">
        <div>
          <p class="eyebrow">Facility experience</p>
          <h2>The work changes when the building changes.</h2>
        </div>
        <p>Explore service considerations for the environments named throughout LT Janitorial’s current catalog and public customer feedback.</p>
      </div>
      <div class="industry-list">
        {featuredIndustries.map((industry, index) => (
          <a href={`/industries/${industry.slug}`}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{industry.name}</strong>
            <em>{industry.hero.title}</em>
            <b aria-hidden="true">↗</b>
          </a>
        ))}
      </div>
      <p class="catalog-link"><a class="button button-dark" href="/industries">Explore facility types</a></p>
    </div>
  </section>

  <section class="section section-ink-raised process-section">
    <div class="shell">
      <div class="section-intro">
        <div>
          <p class="eyebrow">From conversation to scope</p>
          <h2>Every strong program starts by seeing the building.</h2>
        </div>
        <p>The facility walk through connects square footage to the rooms, surfaces, traffic, access, service windows, and results that actually shape the work.</p>
      </div>
      <div class="process-grid">
        <article class="process-step"><span class="step-number">01</span><h3>Understand</h3><p>Share the facility type, location, approximate size, preferred frequency, and the areas that need attention.</p></article>
        <article class="process-step"><span class="step-number">02</span><h3>Walk</h3><p>Review entrances, restrooms, floors, employee areas, operational zones, access, and any specialized spaces.</p></article>
        <article class="process-step"><span class="step-number">03</span><h3>Define</h3><p>Turn the building review into a clear service scope, frequency plan, project sequence, or floor care cycle.</p></article>
      </div>
    </div>
  </section>

  <section class="section section-light">
    <div class="shell area-layout">
      <div>
        <p class="eyebrow">Service area</p>
        <h2>Commercial cleaning across three North Texas counties.</h2>
        <p class="area-copy">The service area follows the business corridors east and north of Dallas, with each city profile organized around the facilities, traffic, and operating priorities found there.</p>
        <a class="button button-dark" href="/service-areas">Explore the complete service area</a>
      </div>
      <div class="city-ledger">
        {featuredCities.map((location) => <a href={`/service-areas/${location.slug}`}><span>{location.name}</span><small>{location.county}</small></a>)}
      </div>
    </div>
  </section>

  <section class="section section-paper">
    <div class="shell faq-layout">
      <div>
        <p class="eyebrow">Questions facility teams ask</p>
        <h2>Clear answers before the walk through.</h2>
        <p>These answers reflect the current public service catalog. Final scope, schedule, and pricing depend on the facility.</p>
        <a class="text-link" href="/faq">See every frequently asked question <span aria-hidden="true">↗</span></a>
      </div>
      <FAQList items={homeFaqs} />
    </div>
  </section>

  <CTASection title="Give the building a cleaning plan it can hold." />
</BaseLayout>

<style>
  .home-hero h1 {
    max-width: 62rem;
  }

  .service-feature-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .service-feature-grid .editorial-card:first-child {
    grid-column: span 2;
  }

  .catalog-link {
    margin: 2.5rem 0 0;
  }

  .precision-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(22rem, 0.7fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: center;
  }

  .precision-copy p:not(.eyebrow) {
    color: var(--muted-dark);
    font-size: 1.08rem;
  }

  .mini-links {
    display: grid;
    margin-top: 2.5rem;
    border-top: 1px solid var(--line-dark);
  }

  .mini-links a {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line-dark);
    color: #d8d0c3;
    text-decoration: none;
  }

  .mini-links a:hover {
    color: var(--gold-light);
  }

  .industry-list {
    border-top: 1px solid var(--line-light);
  }

  .industry-list a {
    display: grid;
    grid-template-columns: 4rem minmax(12rem, 0.6fr) minmax(14rem, 1fr) 2rem;
    gap: 1.25rem;
    align-items: center;
    min-height: 7rem;
    border-bottom: 1px solid var(--line-light);
    color: var(--ink);
    text-decoration: none;
  }

  .industry-list span {
    color: var(--gold-deep);
    font-size: 0.7rem;
    font-weight: 800;
  }

  .industry-list strong {
    font-family: var(--serif);
    font-size: clamp(1.3rem, 2vw, 1.9rem);
    font-weight: 500;
  }

  .industry-list em {
    color: var(--muted-light);
    font-style: normal;
  }

  .area-layout,
  .faq-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(20rem, 0.5fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
  }

  .area-copy {
    max-width: 42rem;
    margin-bottom: 2rem;
    color: var(--muted-light);
    font-size: 1.08rem;
  }

  .city-ledger {
    border-top: 1px solid var(--line-light);
  }

  .city-ledger a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line-light);
    color: var(--ink);
    text-decoration: none;
  }

  .city-ledger span {
    font-family: var(--serif);
    font-size: 1.25rem;
  }

  .city-ledger small {
    color: var(--muted-light);
  }

  @media (max-width: 980px) {
    .service-feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .precision-layout,
    .area-layout,
    .faq-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .service-feature-grid {
      grid-template-columns: 1fr;
    }

    .service-feature-grid .editorial-card:first-child {
      grid-column: auto;
    }

    .industry-list a {
      grid-template-columns: 2rem 1fr 1.5rem;
      padding-block: 1.25rem;
    }

    .industry-list em {
      display: none;
    }
  }
</style>
