---
import BaseLayout from "../layouts/BaseLayout.astro";
import { business } from "../data/business";
---

<BaseLayout
  title="Page Not Found"
  description="The requested LT Janitorial page could not be found."
  canonicalPath="/404"
  noindex
>
  <section class="missing-page">
    <div class="shell">
      <p class="eyebrow">404 / Page not found</p>
      <h1>This route did not make the final walk.</h1>
      <p class="lede">The address may have changed, or the page may no longer exist. Return to the service catalog, request a quote, or call LT Janitorial.</p>
      <div class="hero-actions">
        <a class="button button-gold" href="/services">Explore services</a>
        <a class="button button-ghost" href="/quote">Request a quote</a>
        <a class="button button-ghost" href={business.phoneHref}>Call {business.phoneDisplay}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .missing-page {
    min-height: 75svh;
    display: grid;
    align-items: center;
    padding-block: 8rem;
    background: radial-gradient(circle at 80% 20%, rgba(198, 169, 98, 0.15), transparent 32%), var(--ink);
  }

  .missing-page .shell {
    max-width: 68rem;
  }
</style>
