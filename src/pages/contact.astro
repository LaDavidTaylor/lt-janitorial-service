---
import BaseLayout from "../layouts/BaseLayout.astro";
import InnerHero from "../components/InnerHero.astro";
import QuoteForm from "../components/QuoteForm.astro";
import { business } from "../data/business";
---

<BaseLayout
  title="Contact LT Janitorial Service"
  description="Call, email, or schedule a commercial facility walk through with LT Janitorial Service, LLC across Dallas, Collin, and Rockwall counties."
  canonicalPath="/contact"
>
  <InnerHero
    eyebrow="Start the facility conversation"
    title="Call, email, or prepare the scope details."
    intro="Choose the contact path that fits. The quote planner prepares an email in your own mail application, so you can review every detail before sending it."
    image="/images/generated/commercial-cleaning-hero.webp"
    imageAlt="Commercial lobby with an orderly polished presentation"
    primaryHref={business.phoneHref}
    primaryLabel={`Call ${business.phoneDisplay}`}
    secondaryHref={business.calendly}
    secondaryLabel="Schedule a walk through"
  />

  <section class="section section-light">
    <div class="shell contact-grid">
      <div class="contact-ledger">
        <p class="eyebrow">Direct contact</p>
        <h2>LT Janitorial Service, LLC</h2>
        <dl>
          <div><dt>Phone</dt><dd><a href={business.phoneHref}>{business.phoneDisplay}</a></dd></div>
          <div><dt>Email</dt><dd><a href={business.emailHref}>{business.email}</a></dd></div>
          <div><dt>Walk through</dt><dd><a href={business.calendly} target="_blank" rel="noreferrer">Open the current scheduling calendar</a></dd></div>
          <div><dt>Core territory</dt><dd>Dallas County, Collin County, and Rockwall County</dd></div>
        </dl>
        <p class="contact-note">LT Janitorial operates as a service area business and meets clients at their facilities. Call, email, or use the scheduling calendar to arrange the next step.</p>
      </div>
      <div class="dark-form"><QuoteForm compact /></div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(18rem, 0.38fr) minmax(0, 0.62fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
  }

  .contact-ledger dl {
    margin-top: 3rem;
    border-top: 1px solid var(--line-light);
  }

  .contact-ledger dl div {
    padding: 1rem 0;
    border-bottom: 1px solid var(--line-light);
  }

  .contact-ledger dt {
    color: var(--gold-deep);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-ledger dd {
    margin: 0.25rem 0 0;
  }

  .contact-note {
    margin-top: 2rem;
    color: var(--muted-light);
    font-size: 0.85rem;
  }

  .dark-form {
    color: var(--ivory);
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
